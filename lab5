-- =========================================================================
-- 1. СОЗДАНИЕ БАЗЫ ДАННЫХ (CREATE DATABASE)
-- =========================================================================
CREATE DATABASE IF NOT EXISTS warehouse_clothing_db;
USE warehouse_clothing_db;


-- =========================================================================
-- 2. СОЗДАНИЕ ТАБЛИЦ И СВЯЗЕЙ (CREATE TABLE)
-- =========================================================================

-- Таблица: Справочник моделей одежды
CREATE TABLE clothing_design (
    sku VARCHAR(255) NOT NULL,
    brand VARCHAR(255) NOT NULL,
    model_name VARCHAR(255) NOT NULL,
    category VARCHAR(255) NOT NULL,
    sex VARCHAR(255) NOT NULL,
    size VARCHAR(255) NOT NULL,
    color VARCHAR(255) NOT NULL,
    material VARCHAR(255) NOT NULL,
    retail_price DECIMAL(8, 2) NOT NULL,
    PRIMARY KEY (sku)
);

-- Таблица: Справочник поставщиков
CREATE TABLE suppliers (
    code_suppliers BIGINT NOT NULL AUTO_INCREMENT,
    supplier_name VARCHAR(255) NOT NULL,
    country VARCHAR(255) NOT NULL,
    inn VARCHAR(255) NOT NULL,
    phone_number VARCHAR(255) NOT NULL,
    email VARCHAR(255) NOT NULL,
    office_address VARCHAR(255) NOT NULL,
    PRIMARY KEY (code_suppliers)
);

-- Таблица: Заказы поставщикам (Шапка документа)
CREATE TABLE orders_to_suppliers (
    order_number BIGINT NOT NULL AUTO_INCREMENT,
    code_supplier BIGINT NOT NULL,
    order_date DATE NOT NULL,
    PRIMARY KEY (order_number),
    FOREIGN KEY (code_supplier) REFERENCES suppliers(code_suppliers)
);

-- Таблица: Строки заказов (Спецификация) - СОСТАВНОЙ КЛЮЧ
CREATE TABLE orders_lines (
    order_number BIGINT NOT NULL,
    sku VARCHAR(255) NOT NULL,
    order_quantity BIGINT NOT NULL,
    PRIMARY KEY (order_number, sku),
    FOREIGN KEY (order_number) REFERENCES orders_to_suppliers(order_number),
    FOREIGN KEY (sku) REFERENCES clothing_design(sku)
);

-- Таблица: Поступления грузов (Шапка документа)
CREATE TABLE receiving_shipments (
    waybill_number BIGINT NOT NULL AUTO_INCREMENT,
    delivery_date DATE NOT NULL,
    code_suppliers BIGINT NOT NULL,
    PRIMARY KEY (waybill_number),
    FOREIGN KEY (code_suppliers) REFERENCES suppliers(code_suppliers)
);

-- Таблица: Строки приемки (Спецификация) - СОСТАВНОЙ КЛЮЧ
CREATE TABLE receiving_lines (
    waybill_number BIGINT NOT NULL,
    sku VARCHAR(255) NOT NULL,
    quantity_accepted BIGINT NOT NULL,
    purchase_price DECIMAL(8, 2) NOT NULL,
    PRIMARY KEY (waybill_number, sku),
    FOREIGN KEY (waybill_number) REFERENCES receiving_shipments(waybill_number),
    FOREIGN KEY (sku) REFERENCES clothing_design(sku)
);

-- Таблица: Перемещения в торговый зал (Шапка документа)
CREATE TABLE transfer_sales_floor (
    transfer_number BIGINT NOT NULL AUTO_INCREMENT,
    transfer_date DATE NOT NULL,
    PRIMARY KEY (transfer_number)
);

-- Таблица: Строки перемещений (Спецификация) - СОСТАВНОЙ КЛЮЧ
CREATE TABLE transfer_lines (
    transfer_number BIGINT NOT NULL,
    sku VARCHAR(255) NOT NULL,
    quantity_moved BIGINT NOT NULL,
    destination_zone VARCHAR(255) NOT NULL,
    PRIMARY KEY (transfer_number, sku),
    FOREIGN KEY (transfer_number) REFERENCES transfer_sales_floor(transfer_number),
    FOREIGN KEY (sku) REFERENCES clothing_design(sku)
);

-- Таблица: Инвентаризация (Шапка документа)
CREATE TABLE inventory (
    inventory_number BIGINT NOT NULL AUTO_INCREMENT,
    inventory_date DATE NOT NULL,
    PRIMARY KEY (inventory_number)
);

-- Таблица: Строки инвентаризации (Спецификация) - СОСТАВНОЙ КЛЮЧ
CREATE TABLE inventory_lines (
    inventory_number BIGINT NOT NULL,
    sku VARCHAR(255) NOT NULL,
    actual_quantity BIGINT NOT NULL,
    `condition` VARCHAR(255) NOT NULL,
    PRIMARY KEY (inventory_number, sku),
    FOREIGN KEY (inventory_number) REFERENCES inventory(inventory_number),
    FOREIGN KEY (sku) REFERENCES clothing_design(sku)
);

-- Таблица: Чеки продаж (Шапка документа)
CREATE TABLE sales_receipts (
    receipt_number BIGINT NOT NULL AUTO_INCREMENT,
    date_time DATETIME NOT NULL,
    payment_type VARCHAR(255) NOT NULL,
    PRIMARY KEY (receipt_number)
);

-- Таблица: Строки чеков (Спецификация) - СОСТАВНОЙ КЛЮЧ
CREATE TABLE receipts_lines (
    receipt_number BIGINT NOT NULL,
    sku VARCHAR(255) NOT NULL,
    sales_quantity BIGINT NOT NULL,
    selling_price DECIMAL(8, 2) NOT NULL,
    PRIMARY KEY (receipt_number, sku),
    FOREIGN KEY (receipt_number) REFERENCES sales_receipts(receipt_number),
    FOREIGN KEY (sku) REFERENCES clothing_design(sku)
);


-- =========================================================================
-- 3. ИЗМЕНЕНИЕ СТРУКТУРЫ ТАБЛИЦ (ALTER TABLE)
-- =========================================================================
-- Добавим индексы для ускорения связывания и поиска (как в исходном коде)
ALTER TABLE orders_to_suppliers ADD INDEX idx_orders_code_supplier (code_supplier);
ALTER TABLE receiving_shipments ADD INDEX idx_receiving_code_suppliers (code_suppliers);


